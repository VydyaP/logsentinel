# Copy to .env and fill in what you need. Everything is optional.
# Never commit the real .env file.

# Database. Default: a local SQLite file. Docker Compose sets this for you.
# Neon / any hosted Postgres: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=postgresql+psycopg://logsentinel:logsentinel@localhost:5432/logsentinel

# Protects the REST API's write endpoints (ingest, detect, update alert) when set.
API_KEY=

# Slack incoming webhook (https://api.slack.com/messaging/webhooks)
SLACK_WEBHOOK_URL=

# E-mail via SMTP (STARTTLS)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# Lowest severity that triggers a notification: low | medium | high | critical
NOTIFY_MIN_SEVERITY=high

# Alerts from the same source within this many hours are grouped into one incident
INCIDENT_WINDOW_HOURS=24

# Dashboard: 1 hides the triage buttons (useful for a public read-only demo)
READ_ONLY=0

# Link back to the dashboard, written into every ticket
DASHBOARD_URL=http://localhost:8501

# ---------------------------------------------------------------- ticketing
# noop (default: nothing leaves this machine) | servicenow
TICKETING_PROVIDER=noop
# Lowest incident severity that opens a ticket: low | medium | high | critical
TICKET_MIN_SEVERITY=high

# ServiceNow (only used when TICKETING_PROVIDER=servicenow). Use a dedicated
# integration user with the itil role, never admin. See docs/runbooks/servicenow-integration.md
SERVICENOW_INSTANCE_URL=https://devXXXXX.service-now.com
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=
# Incident category (default PDI choices: inquiry, software, hardware, network, database)
SERVICENOW_CATEGORY=network
# Optional: sys_id of the assignment group (e.g. your SOC group)
SERVICENOW_ASSIGNMENT_GROUP=
SERVICENOW_TIMEOUT=15
SERVICENOW_MAX_RETRIES=4
